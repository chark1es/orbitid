# Frontend API base URL is encoded in the publishable key. The server prints this key on start.
NEXT_PUBLIC_ORBITID_PUBLISHABLE_KEY=pk_test_aHR0cDovL2xvY2FsaG9zdDo0MDAw

# Backend API key. Unlocks the seed data page, webhook endpoint registration and session settings.
ORBITID_SECRET_KEY=

# Optional. Defaults to the frontend API URL decoded from the publishable key.
ORBITID_API_URL=

# Optional. Secret of a webhook endpoint registered in the dashboard. Without it, register the
# receiver from the Webhooks page or paste the endpoint secret into the form there.
ORBITID_WEBHOOK_SECRET=

NEXT_PUBLIC_ORBITID_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_ORBITID_SIGN_UP_URL=/sign-up
