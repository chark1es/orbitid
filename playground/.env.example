# Labels: see docs/ENVIRONMENT.md.
#   WEBSITE · BROWSER (public)  inlined into client code, visible to everyone
#   WEBSITE · BACKEND (secret)  playground server only, never prefix with NEXT_PUBLIC_

# ── WEBSITE · BROWSER (public) ──────────────────────────────────────────────
# [required] Publishable key. The Frontend API URL is encoded in it; the OrbitID server prints it on start.
NEXT_PUBLIC_ORBITID_PUBLISHABLE_KEY=pk_test_aHR0cDovL2xvY2FsaG9zdDo0MDAw
NEXT_PUBLIC_ORBITID_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_ORBITID_SIGN_UP_URL=/sign-up

# ── WEBSITE · BACKEND (secret) ──────────────────────────────────────────────
# [recommended] Backend API key. Unlocks the seed data page, webhook endpoint registration and session settings.
ORBITID_SECRET_KEY=
# [optional] Defaults to the API URL decoded from the publishable key.
ORBITID_API_URL=
# [optional] Secret of a webhook endpoint registered in the dashboard. Without it, register the receiver
# from the Webhooks page or paste the endpoint secret into the form there.
ORBITID_WEBHOOK_SECRET=
