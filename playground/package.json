    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@orbitid/backend": "*",
    "@orbitid/nextjs": "*",
    "@orbitid/react": "*",
    "@orbitid/shared": "*",
    "@orbitid/ui": "*",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4",
    "jsdom": "^25.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.0.0"
  }
