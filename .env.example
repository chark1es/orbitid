# ─────────────────────────────────────────────────────────────────────────────
# SERVER  ·  the machine that runs OrbitID (used by docker-compose.yml, copy to .env)
#
# Everything here stays on the server. None of these values belong in a website,
# a browser bundle or your app's backend. Website variables are listed in
# docs/ENVIRONMENT.md under "WEBSITE · BROWSER" and "WEBSITE · BACKEND".
# ─────────────────────────────────────────────────────────────────────────────

# [SERVER · required] Encrypts signing keys, TOTP secrets, OAuth tokens and stored provider
# secrets in the database, and derives your secret key. Keep it stable and backed up:
# changing it makes stored secrets unreadable. At least 32 characters.
#   openssl rand -base64 32
ORBITID_ENCRYPTION_KEY=

# [SERVER · required in production] Public URL of this server, as browsers and your apps reach it.
ORBITID_BASE_URL=http://localhost:4000
ORBITID_PORT=4000

# [SERVER · required for docker-compose] Password for the bundled Postgres container.
POSTGRES_PASSWORD=orbitid

# [SERVER · optional] Number of reverse proxies in front of the server (0 = none). Set to 1 behind
# one proxy you run, so rate limits and session records see the client address.
# ORBITID_TRUST_PROXY=0

# [SERVER · optional] Email delivery for sign-in codes and links. Pick one. Without either, codes
# are printed to the server log. These can also be set in the dashboard under Email and SMS.
# ORBITID_RESEND_API_KEY=re_...
# ORBITID_SMTP_URL=smtps://user:password@smtp.example.com:465
# ORBITID_EMAIL_FROM="Acme <no-reply@acme.com>"
