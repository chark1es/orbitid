# Used by docker-compose.yml. Copy to .env.

# Required. Encrypts signing keys, TOTP secrets and OAuth tokens in the database, and derives your
# secret key. Keep it stable: changing it makes stored secrets unreadable.
#   openssl rand -base64 32
ORBITID_ENCRYPTION_KEY=

# Public URL of this server, as browsers and your apps reach it.
ORBITID_BASE_URL=http://localhost:4000
ORBITID_PORT=4000

# Number of reverse proxies in front of the server (0 = none). Set to 1 behind one proxy you run.
# ORBITID_TRUST_PROXY=0

# Password for the bundled Postgres container.
POSTGRES_PASSWORD=orbitid
