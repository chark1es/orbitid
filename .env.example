# ─────────────────────────────────────────────────────────────────────────────
# SERVER  ·  the machine that runs OrbitID (used by docker-compose.yml, copy to .env)
#
# Everything here stays on the server. None of these values belong in a website,
# a browser bundle or your app's backend. Website variables are listed in
# docs/ENVIRONMENT.md under "WEBSITE · BROWSER" and "WEBSITE · BACKEND".
#
# The server is Postgres-only: there is no SQLite or PGlite mode.
# ─────────────────────────────────────────────────────────────────────────────

# [SERVER · required] Postgres connection URL. `postgres://` or `postgresql://`.
# The server refuses any other scheme. Migrations run automatically on start. A password containing
# / + = @ : % or a space must be percent-encoded in a URL; to avoid that, leave this unset and use the
# separate ORBITID_DATABASE_HOST / _PORT / _USER / _PASSWORD / _NAME (or PGHOST, PGPORT, PGUSER,
# PGPASSWORD, PGDATABASE) instead, which take the password verbatim. The URL wins when both are set.
ORBITID_DATABASE_URL=postgres://orbitid:orbitid@localhost:5432/orbitid
# ORBITID_DATABASE_HOST=localhost
# ORBITID_DATABASE_PORT=5432
# ORBITID_DATABASE_USER=orbitid
# ORBITID_DATABASE_PASSWORD=
# ORBITID_DATABASE_NAME=orbitid

# [SERVER · required] Encrypts signing keys, TOTP secrets, OAuth tokens and stored provider
# secrets in the database, and derives your secret key. Keep it stable and backed up:
# changing it makes stored secrets unreadable. At least 32 characters.
#   openssl rand -base64 32
ORBITID_ENCRYPTION_KEY=

# [SERVER · required in production] Public URL of this server, as browsers and your apps reach it.
ORBITID_BASE_URL=http://localhost:4000
ORBITID_PORT=4000

# [SERVER · required for docker-compose] Password for the bundled Postgres container. There is no
# default: compose refuses to start until you set it. Use a random value and keep it with the volume.
# Compose passes it to the server as ORBITID_DATABASE_PASSWORD (separate parts, no URL), so any value
# works; the ORBITID_DATABASE_URL above is used when you run the server from source.
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# [SERVER · optional] Backend API secret key (`sk_live_…`). Omit it to derive a strong key from
# ORBITID_ENCRYPTION_KEY; an explicit production key must be at least 32 random characters.
# Print the effective key with: orbitid keys
# ORBITID_SECRET_KEY=

# [SERVER · optional] Postgres pool tuning. Each replica also opens one dedicated LISTEN connection
# for settings changes, so keep replicas x (ORBITID_DB_MAX_CONNECTIONS + 1) below Postgres's
# max_connections (docker-compose.yml sets 300, which fits the documented 5-replica example).
# Lower the per-replica pool when you scale out further.
# ORBITID_DB_MAX_CONNECTIONS=20
# ORBITID_DB_ACQUIRE_TIMEOUT_MS=30000

# [SERVER · optional] Request deadline and graceful-shutdown drain. 0 disables the request timeout.
# ORBITID_REQUEST_TIMEOUT_MS=30000
# ORBITID_DRAIN_TIMEOUT_MS=10000

# [SERVER · optional] Extra connect-src origin for the dashboard Content-Security-Policy.
# ORBITID_DASHBOARD_CONNECT_SRC=

# [SERVER · optional] Retention. Webhooks: terminal deliveries and their events after N days (0 keeps
# forever). Audit logs: 0 (the default) keeps them forever; a positive value deletes older rows.
# ORBITID_WEBHOOK_RETENTION_DAYS=30
# ORBITID_AUDIT_RETENTION_DAYS=0

# [SERVER · optional] Number of reverse proxies in front of the server (0 = none, `true` = 1).
# Set to 1 behind one proxy or load balancer, so rate limits, session records and cookie
# security see the client address and scheme.
# ORBITID_TRUST_PROXY=0

# [SERVER · optional] Email delivery for sign-in codes and links. Pick one. Without either,
# email-dependent flows refuse to start; there is no console/file fallback that prints codes.
# These can also be set in the dashboard under Email and SMS.
# ORBITID_RESEND_API_KEY=re_...
# ORBITID_SMTP_URL=smtps://user:password@smtp.example.com:465
# ORBITID_EMAIL_FROM="Acme <no-reply@acme.com>"

# [SERVER · optional] Let webhooks and identity providers reach localhost/private addresses.
# Development mode allows this anyway. See docs/SECURITY.md.
# ORBITID_ALLOW_PRIVATE_NETWORKS=false

# [SERVER · optional] Uploads are stored in Postgres. ORBITID_DATA_DIR only needs to be a
# writable directory at boot (the image uses /tmp/orbitid); it holds no deployment data.
# ORBITID_DATA_DIR=./data
