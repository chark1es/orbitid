{
  "name": "orbitid",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source, self-hosted authentication and user management.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "playground"
  ],
  "scripts": {
    "dev:server": "bun run --filter @orbitid/server dev",
    "dev:dashboard": "bun run --filter @orbitid/dashboard dev",
    "dev:example": "bun run --filter example-next dev",
    "typecheck": "bun run --filter \"*\" typecheck",
    "test": "bun run --filter \"*\" test",
    "db:generate": "bun run --filter @orbitid/server db:generate",
    "dev:example-node": "bun run --filter example-node dev",
    "check:files": "node scripts/check-repository.mjs sizes",
    "check:docs": "node scripts/check-repository.mjs docs",
    "test:maintenance": "node --test scripts/check-repository.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "@embedded-postgres/linux-x64",
    "@node-rs/argon2",
    "better-sqlite3",
    "esbuild"
  ],
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "ts-morph": "^28.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "postcss": "^8.5.32"
  }
}
