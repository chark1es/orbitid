{
  "name": "orbitid",
  "private": true,
  "version": "0.1.0",
  "description": "Open source authentication & user management platform \u2014 a Clerk alternative.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "bun run dev -w @orbitid/server",
    "dev:dashboard": "bun run dev -w @orbitid/dashboard",
    "dev:example": "bun run dev -w example-next",
    "typecheck": "bun run --filter \"*\" typecheck",
    "test": "bun run --filter \"*\" test",
    "db:generate": "bun run db:generate -w @orbitid/server"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild",
    "@node-rs/argon2"
  ]
}
