# Public URL of this server. Also the JWT issuer and the Frontend API base encoded in the publishable key.
ORBITID_BASE_URL=http://localhost:4000
PORT=4000

# Where the SQLite database, uploads and generated keys live.
ORBITID_DATA_DIR=./data

# Backend API secret (sk_test_… / sk_live_…). Generated into <data dir>/keys.json on first boot when unset.
ORBITID_SECRET_KEY=

# 32+ characters. Encrypts signing keys, TOTP secrets and OAuth tokens at rest. CHANGE IN PRODUCTION.
ORBITID_ENCRYPTION_KEY=
