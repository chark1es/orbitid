{
  "name": "@orbitid/server",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "orbitid": "./src/cli.ts"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "start": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:generate": "bun run db:generate:postgres && bun run db:generate:sqlite",
    "db:generate:postgres": "ORBITID_DB_DIALECT=postgres drizzle-kit generate",
    "db:generate:sqlite": "ORBITID_DB_DIALECT=sqlite drizzle-kit generate",
    "test:postgres": "ORBITID_DB_DIALECT=postgres vitest run --passWithNoTests"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@hono/node-server": "^1.13.0",
    "@node-rs/argon2": "^2.0.0",
    "@node-saml/node-saml": "^5.0.0",
    "@orbitid/shared": "*",
    "@simplewebauthn/server": "^10.0.0",
    "arctic": "^2.2.0",
    "better-sqlite3": "^11.5.0",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "nanoid": "^5.0.0",
    "nodemailer": "^6.9.0",
    "otplib": "^12.0.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.0",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
