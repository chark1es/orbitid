# OrbitID server (Frontend API base URL encoded in the publishable key).
NEXT_PUBLIC_ORBITID_PUBLISHABLE_KEY=pk_test_aHR0cDovL2xvY2FsaG9zdDo0MDAw
NEXT_PUBLIC_ORBITID_API_URL=http://localhost:4000

# Where the prebuilt components live.
NEXT_PUBLIC_ORBITID_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_ORBITID_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_ORBITID_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_ORBITID_AFTER_SIGN_UP_URL=/dashboard

# Server-only: Backend API secret key (currentUser(), orbitIdClient(), server actions).
ORBITID_SECRET_KEY=sk_test_replace_me

# Public key (PEM) used by the middleware to verify session JWTs offline.
# Without it, middleware verifies through GET /.well-known/jwks.json on the API URL.
ORBITID_JWT_KEY=

# Optional: comma-separated app origins accepted in the `azp` claim.
ORBITID_AUTHORIZED_PARTIES=http://localhost:3000

# Signing secret of the webhook endpoint registered in the OrbitID dashboard.
ORBITID_WEBHOOK_SECRET=whsec_replace_me
