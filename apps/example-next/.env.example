# Labels: see docs/ENVIRONMENT.md.
#   WEBSITE · BROWSER (public)  inlined into client code, visible to everyone
#   WEBSITE · BACKEND (secret)  Next.js server only, never prefix with NEXT_PUBLIC_

# ── WEBSITE · BROWSER (public) ──────────────────────────────────────────────
# [required] Publishable key. The OrbitID server prints it on start and the dashboard shows it.
NEXT_PUBLIC_ORBITID_PUBLISHABLE_KEY=pk_test_aHR0cDovL2xvY2FsaG9zdDo0MDAw
# [optional] URL of your OrbitID server when it differs from the one encoded in the key.
NEXT_PUBLIC_ORBITID_API_URL=http://localhost:4000
# [optional] Where the prebuilt components live.
NEXT_PUBLIC_ORBITID_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_ORBITID_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_ORBITID_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_ORBITID_AFTER_SIGN_UP_URL=/dashboard

# ── WEBSITE · BACKEND (secret) ──────────────────────────────────────────────
# [required] Backend API key (currentUser(), orbitIdClient(), server actions).
ORBITID_SECRET_KEY=sk_test_replace_me
# [optional] Public key (PEM) that lets the middleware verify session tokens offline.
# Without it, middleware reads GET /.well-known/jwks.json from the API URL.
ORBITID_JWT_KEY=
# [optional] Comma-separated app origins accepted in the token's `azp` claim.
ORBITID_AUTHORIZED_PARTIES=http://localhost:3000
# [only to receive webhooks] Signing secret of the webhook endpoint registered in the dashboard.
ORBITID_WEBHOOK_SECRET=whsec_replace_me
