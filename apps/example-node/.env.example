# Required. Backend API secret (`sk_test_…` / `sk_live_…`). Create it in the dashboard under API keys,
# or copy the value the server prints on first boot. Never ship this to a browser.
ORBITID_SECRET_KEY=

# Optional. Base URL of your OrbitID server. Defaults to the URL encoded in ORBITID_PUBLISHABLE_KEY,
# then to the SDK's built-in default.
ORBITID_API_URL=http://localhost:4000

# Optional. Only used to derive ORBITID_API_URL when that variable is unset.
ORBITID_PUBLISHABLE_KEY=

# Optional. Webhook signing secret for POST /api/webhooks (`whsec_…`). Without it the endpoint
# answers 400 for every delivery it receives.
ORBITID_WEBHOOK_SECRET=

# Optional. Port this example listens on.
PORT=3001
