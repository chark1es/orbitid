# Keep the build context small and free of anything secret or machine-specific.
node_modules
**/node_modules

# Rust build output. Docker builds in its own layer cache; a local target would
# copy gigabytes and poison the dependency cache.
target
target-*
target-pkg

# Frontend build output is rebuilt inside the image.
**/dist
**/.next
**/.turbo
**/tsconfig.tsbuildinfo

# Local data and database files. The Rust server is Postgres-only and keeps
# uploads in the database, so nothing here belongs in an image layer.
data
uploads

# Secrets and local configuration never enter an image layer.
.env
.env.*
!.env.example
*.pem
*.p8
*.key

# Repository and tooling noise.
.git
.gitignore
.github
**/*.log
**/coverage
.DS_Store
